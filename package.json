{
    "name": "velson-backend",
    "version": "2.0.0",
    "description": "PostgreSQL + Docker CRUD API for VELSON Industries, Salem",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "seed": "node seeds/seedData.js",
        "seed:reset": "node seeds/seedData.js --reset",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:reset": "docker-compose down -v && docker-compose up -d"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.0",
        "morgan": "^1.10.0",
        "pg": "^8.20.0"
    },
    "devDependencies": {
        "nodemon": "^3.1.4"
    }
}
